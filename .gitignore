**.idea/

# Generated by Cargo
# will have compiled files and executables
**target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
**Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk


# Added by cargo

/target
Cargo.lock

# Local design docs / specs / planning notes — keep out of the repo.
/docs/

# macOS Finder metadata
.DS_Store

# Coverage artifacts (cargo-llvm-cov / cargo-tarpaulin output)
/cobertura.xml
/tarpaulin-report.html
/lcov.info
/coverage/

# Stray compiled artifacts that escape target/ (e.g. proc-macro / no-panic build products)
*.rlib
*.rmeta

# Python bytecode from `hick-onlink/probes/mutations.py`.
__pycache__/
